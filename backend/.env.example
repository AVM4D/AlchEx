# ═══════════════════════════════════════════════════════════
#  AlchEx Backend — Environment Variables
#  Copy this file to .env and fill in YOUR values
#  Command:  copy .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Server ───
PORT=4000
NODE_ENV=development

# ─── Database (SQL Server) ───
# Option A – Windows Authentication (no password needed):
#   DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=alchex;integratedSecurity=true;trustServerCertificate=true"
#
# Option B – SQL Server Authentication:
#   DATABASE_URL="sqlserver://localhost:1433;database=alchex;user=sa;password=YOUR_PASSWORD;trustServerCertificate=true"
DATABASE_URL="sqlserver://localhost;instanceName=SQLEXPRESS;database=alchex;integratedSecurity=true;trustServerCertificate=true"

# ─── JWT Secrets (change these!) ───
JWT_ACCESS_SECRET=CHANGE_ME_random_string_1
JWT_REFRESH_SECRET=CHANGE_ME_random_string_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───
CORS_ORIGIN=http://localhost:5173

# ─── Email / SMTP (optional – for email verification) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── File Uploads ───
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ─── AI Moderation (optional) ───
OPENAI_API_KEY=
MODERATION_ENABLED=false
