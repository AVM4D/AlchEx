{
  "info": {
    "_postman_id": "63cf8130-c96e-4955-a2b1-f7f7a5e4de71",
    "name": "AlchEx Admin + Notifications + Ratings",
    "description": "Companion collection for the core flow. Assumes user tokens and transactionId already exist in environment from the core collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "A - Ratings + Notifications (User 1)",
      "item": [
        {
          "name": "1) Set token = user1",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('accessToken', pm.environment.get('user1AccessToken'));",
                  "pm.test('Switched to user1 token', function () {",
                  "  pm.expect(pm.environment.get('accessToken')).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2) Complete transaction (if not already)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "{{transactionId}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Complete transaction handled', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 403, 409]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3) Create rating (User 1 rates counterpart)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"score\": 5,\n  \"review\": \"Great collaboration and clear communication during the exchange.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/ratings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "ratings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rating create response is valid', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 403, 409]);",
                  "  if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json?.data?.id) pm.environment.set('ratingId', json.data.id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4) Get my notifications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notifications fetched', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  const bag = json.data || {};",
                  "  const list = bag.notifications || bag.items || bag.rows || [];",
                  "  const first = Array.isArray(list) && list.length ? list[0] : null;",
                  "  if (first && first.id) pm.environment.set('notificationId', first.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5) Mark one notification as read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "{{notificationId}}", "read"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mark one read handled', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6) Mark all notifications as read",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "read-all"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mark all read success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7) Delete one notification",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/{{notificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "{{notificationId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Delete notification handled', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "B - Admin Checks (requires seeded admin)",
      "item": [
        {
          "name": "1) Set token = adminAccessToken",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('accessToken', pm.environment.get('adminAccessToken'));",
                  "pm.test('Admin token set (if provided)', function () {",
                  "  pm.expect(pm.environment.get('accessToken')).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2) Admin dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin dashboard authorization/result', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3) Admin users list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin users list authorization/result', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4) Admin transactions list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin transactions authorization/result', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "C - Security Negative",
      "item": [
        {
          "name": "1) Get notifications without token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthorized without token', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" }
  ]
}
