      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) {",
          "  pm.environment.set('runId', Date.now().toString());",
          "}",
          "if (!pm.environment.get('user1Email')) {",
          "  pm.environment.set('user1Email', `alice_${pm.environment.get('runId')}@university.edu`);",
          "}",
          "if (!pm.environment.get('user2Email')) {",
          "  pm.environment.set('user2Email', `bob_${pm.environment.get('runId')}@university.edu`);",
          "}"
        ]
      }
    }
  ],
