# ═══════════════════════════════════════
#  AlchEx – Git Ignore
# ═══════════════════════════════════════

# Environment / secrets (NEVER commit these)
.env
.env.local
.env.development
.env.production
.env.*.local

# Dependencies
node_modules/

# Build outputs
dist/
build/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.code-workspace

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma local DB files
backend/prisma/*.db

# Uploads (user-generated files)
backend/uploads/
